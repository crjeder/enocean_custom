# Long-lived access token for integration test runner
# This matches the token in .storage/auth — it is a TEST-ONLY token, not a real secret.
HA_TOKEN=test_long_lived_token_for_integration_tests_do_not_use_in_prod
HA_URL=http://homeassistant:8123

# Virtual serial device paths
DONGLE_HA_SIDE=/dev/ttyVirtual0
DONGLE_TEST_SIDE=/tmp/vserial/test_end
